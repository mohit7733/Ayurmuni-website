# Copy to .env.production (or set in your hosting dashboard) before `npm run build`.
# Backend base URL used for REST calls and the chat WebSocket (wss://<same host>).
# VITE_API_BASE=https://ayurmuni.aimantra.info/


VITE_API_BASE=https://ayurmuni.aimantra.info/

# Cashfree hosted checkout. Use sandbox only when the backend creates test orders.
VITE_CASHFREE_MODE=production
# OneSignal web push (public client id, same as the app's ONE_SIGNAL_APP_ID)
VITE_ONESIGNAL_APP_ID=5c79696d-81e8-46a7-922d-b0b08eef4e57
# Meta (Facebook) Pixel — public pixel id from Events Manager
VITE_META_PIXEL_ID=3563256325632

# Temporary consult-only launch. true = non-consult features show "Coming soon".
# false or unset = full access. Per-feature true/false: src/launch/comingSoonMode.js (COMING_SOON_FEATURES).
VITE_COMING_SOON=true
# Google Ads conversion tag (public AW- id) + Website Lead send_to
VITE_GOOGLE_ADS_ID=AW-2563256532
VITE_GOOGLE_ADS_LEAD_SEND_TO=AW-26585325632/Ryu5CPe63bodEMKKgINF
